# Copy into Railway BE service Variables (do not commit real secrets)

# --- Runtime (Railway injects PORT) ---
# PORT is set automatically by Railway
SERVER_PORT=

# --- MySQL (from Railway MySQL plugin — map names from dashboard) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_SCHEMA=db_clinic
MYSQL_ROOT_USERNAME=
MYSQL_ROOT_PASSWORD=

# --- Redis (Railway Redis plugin — REQUIRED for slot hold / idempotency) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# --- Security ---
# Generate: openssl rand -base64 48
JWT_SECRET=

# --- CORS (Vercel production + previews) ---
# Example:
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://*.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional: mail / push ---
MAIL_HOST=
MAIL_PORT=587
PUSH_PROVIDER=STUB
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=
